# Copy to .env and fill in. Never commit .env.
#
# Nested settings merge key by key across this file and the environment, and an empty value
# counts as not set. To clear a value from the environment, set it to the word null:
# LLM__EXTRA_BODY=null. `python -m supportagent.cli.preflight` prints the models as they came out.

# Postgres with pgvector. scripts/dev-db.sh reads POSTGRES_PASSWORD.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://support:change-me@127.0.0.1:54329/support

# Vercel AI Gateway: LLM, embeddings, reranker.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Deepgram: speech to text and text to speech.
DEEPGRAM_API_KEY=

# The model that runs the agent. BASE_URL and API_KEY default to the gateway.
# EXTRA_BODY is JSON sent with every request: here the reasoning effort and the one provider that
# may serve the model. Prices are dollars per million tokens. Without them no cost is reported.
LLM__MODEL=alibaba/qwen3.8-27b
LLM__EXTRA_BODY={"reasoning_effort":"none","providerOptions":{"gateway":{"only":["cerebras"]}}}
LLM__STRICT_TOOLS=true
LLM__INPUT_PRICE=0.99
LLM__OUTPUT_PRICE=1.49

# A second model on another provider. It takes over when the first one fails.
# FALLBACK__MODEL=google/gemini-3.6-flash
# FALLBACK__EXTRA_BODY={"reasoning_effort":"minimal"}
# FALLBACK__INPUT_PRICE=0.75
# FALLBACK__OUTPUT_PRICE=3.75

# The model that checks answers against the evidence. Use a different provider than LLM__MODEL.
# The app does not start without a judge. ALLOW_UNCHECKED_ANSWERS=true lets a development setup
# run without one, and then every answer goes out unchecked.
JUDGE__MODEL=google/gemini-3.6-flash
JUDGE__EXTRA_BODY={"reasoning_effort":"minimal"}
JUDGE__INPUT_PRICE=0.75
JUDGE__OUTPUT_PRICE=3.75
# For an endpoint that rejects a JSON schema on the reply:
# JUDGE__JSON_SCHEMA=false

# Time limits for a model call, in seconds: until the first token, for one attempt, and for the
# whole call with its retries and its fallback. A local model that loads its weights needs more.
# LLM_FIRST_TOKEN_TIMEOUT_S=8
# LLM_TOTAL_TIMEOUT_S=45
# LLM_DEADLINE_S=90

# Retrieval models. A name that starts with "gateway:" is served by the gateway. Any other name
# is a small ONNX model run inside the backend.
# EMBED_MODEL=gateway:alibaba/qwen3-embedding-8b
# EMBED_QUERY_INSTRUCTION=Given a customer support question, retrieve help center passages that answer the question
# RERANK_MODEL=gateway:cohere/rerank-v5-pro

# Scope gate thresholds on the reranker's score. They belong to RERANK_MODEL: recalibrate all
# three with supportagent.evals.retrieval when the reranker changes.
GATE_LOW=-4.0
GATE_HIGH=2.0
GATE_GAP=3.0

# Browser origins that may open the WebSocket, as a JSON list. A client that sends no Origin is
# not a browser and is let in unless REQUIRE_ORIGIN is true.
ALLOWED_ORIGINS=["http://localhost:3000"]
# REQUIRE_ORIGIN=true

# Lets a client queue simulated failures for its own session, to show how the app recovers.
# FAULT_INJECTION=true

# Store the full prompt and response of every model call for the observability drawer.
CAPTURE_PROMPTS=true

# Port for scripts/dev-server.sh and the WebSocket terminal client. Defaults to 8787.
# SUPPORTAGENT_PORT=8787
