# Copy to .env and fill in. Never commit .env.
#
# Nested settings merge key by key across this file and the environment, and an empty value
# counts as not set. To clear a value from the environment, set it to the word null:
# LLM__EXTRA_BODY=null. `python -m supportagent.cli.preflight` prints the models as they came out.

# Postgres with pgvector. scripts/dev-db.sh reads POSTGRES_PASSWORD.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://support:change-me@127.0.0.1:54329/support

# OpenRouter: LLM, embeddings, reranker.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Deepgram: speech to text and text to speech. Without a key the app has no voice, and the page
# shows no microphone. The voice is a model name of Deepgram's Flux TTS.
DEEPGRAM_API_KEY=
# TTS_MODEL=flux-haley-en
# VOICE_GREETING=true
# What voice may use: seconds of one voice session, seconds of silence before it turns itself
# off, and voice sessions at one time in this process.
# VOICE_MAX_SECONDS=600
# VOICE_IDLE_SECONDS=120
# MAX_VOICE_SESSIONS=4

# The model that runs the agent. BASE_URL and API_KEY default to OpenRouter.
# EXTRA_BODY is JSON sent with every request: here the two providers that may serve the model.
# Crusoe declares full precision (bf16). Friendli declares no quantization. The bake-off ran on
# this pair. Prices are dollars per million tokens. Without them no cost is reported.
# Gemma 4 31B won the bake-off of 2026-11-26.
LLM__MODEL=google/gemma-4-31b-it
LLM__EXTRA_BODY={"provider":{"only":["crusoe","friendli"],"sort":"latency"}}
LLM__INPUT_PRICE=0.14
LLM__OUTPUT_PRICE=0.4

# A second model on another provider. It takes over when the first one fails.
FALLBACK__MODEL=openai/gpt-6-luna
FALLBACK__EXTRA_BODY={"reasoning":{"effort":"none"},"provider":{"only":["openai"]}}
FALLBACK__INPUT_PRICE=0.1
FALLBACK__OUTPUT_PRICE=0.5

# The model that checks answers against the evidence. Use a different provider than LLM__MODEL.
# The app does not start without a judge. ALLOW_UNCHECKED_ANSWERS=true lets a development setup
# run without one, and then every answer goes out unchecked.
JUDGE__MODEL=google/gemini-3.6-flash
JUDGE__EXTRA_BODY={"reasoning":{"effort":"minimal"},"provider":{"only":["google-ai-studio","google-vertex"]}}
JUDGE__INPUT_PRICE=0.75
JUDGE__OUTPUT_PRICE=3.75
# For an endpoint that rejects a JSON schema on the reply:
# JUDGE__JSON_SCHEMA=false

# Time limits for a model call, in seconds: until the first token, between two chunks of the
# stream, for one attempt, and for the whole call with its retries and its fallback. A local
# model needs more: it loads its weights before the first token, and its server sends a tool
# call in one piece, so a slow machine is silent for as long as the call takes to write.
# LLM_FIRST_TOKEN_TIMEOUT_S=8
# LLM_STALL_TIMEOUT_S=10
# LLM_TOTAL_TIMEOUT_S=45
# LLM_DEADLINE_S=90

# Retrieval models. A name that starts with "openrouter:" is served by OpenRouter. Any other name
# is a small ONNX model run inside the backend. The small local embedder found the same passages
# as Qwen3-Embedding-8B on our question sets and answers in milliseconds instead of seconds, so
# only the reranker is hosted. Without a key, leave RERANK_MODEL unset to use a local one.
# EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=openrouter:cohere/rerank-5-pro

# Scope gate thresholds on the reranker's score. They belong to RERANK_MODEL: recalibrate all
# three with supportagent.evals.retrieval when the reranker changes. These fit cohere/rerank-5-pro.
# For the local reranker the defaults are -4.0, 2.0 and 3.0.
GATE_LOW=-0.2
GATE_HIGH=0.5
GATE_GAP=1.5

# Browser origins that may open the WebSocket, as a JSON list. A client that sends no Origin is
# not a browser and is let in unless REQUIRE_ORIGIN is true.
ALLOWED_ORIGINS=["http://localhost:3000"]
# REQUIRE_ORIGIN=true

# What one visitor may use: new conversations per address and hour, messages per conversation,
# pick-ups of one failed or stopped message, and open connections per address.
# Behind a host's proxy, name the header in which it reports the visitor, or every visitor counts
# as the proxy. It must be a header the proxy overwrites: X-Real-IP on Railway.
# MAX_NEW_SESSIONS_PER_HOUR=30
# MAX_TURNS_PER_SESSION=60
# MAX_RETRIES_PER_TURN=3
# MAX_CONNECTIONS_PER_ADDRESS=12
# CLIENT_ADDRESS_HEADER=x-real-ip

# What all visitors together may spend on models in 24 hours, in dollars. At the limit no new
# turn starts. Unset means no limit of the app's own: the cap on the provider key still holds.
# DAILY_BUDGET_USD=1.50
# The same for speech, which is Deepgram's bill and not OpenRouter's. At the limit voice does not
# come on and a spoken message starts no turn. Typed messages go on.
# DAILY_SPEECH_BUDGET_USD=3

# A connection that sends nothing for this many seconds is closed. The page comes back by itself.
# IDLE_TIMEOUT_S=1800

# Keys the stored hashes of the PINs a conversation used, so the database alone cannot give
# them back. Any long random string. Without it the hashes are salted by the session only.
# SECRET_KEY=

# Delete conversations and their copies of the demo data after this many hours. Unset keeps them.
# SESSION_TTL_HOURS=48

# Lets a client queue simulated failures for its own session, to show how the app recovers.
# FAULT_INJECTION=true

# Store the full prompt and response of every model call for the observability drawer.
CAPTURE_PROMPTS=true

# Port for scripts/dev-server.sh and the WebSocket terminal client. Defaults to 8787.
# SUPPORTAGENT_PORT=8787
